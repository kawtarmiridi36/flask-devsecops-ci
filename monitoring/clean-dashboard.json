{
  "dashboard": {
    "title": "Flask DevSecOps Dashboard",
    "tags": ["flask", "devsecops", "monitoring"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "🚀 Application Health Overview",
        "type": "stat",
        "description": "Overall application health status",
        "gridPos": {"h": 3, "w": 6, "x": 0, "y": 0},
        "targets": [{
          "expr": "flask_health_status",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "mappings": [
              {
                "type": "value",
                "options": {
                  "1": {"text": "✅ Healthy"},
                  "0": {"text": "❌ Unhealthy"}
                }
              }
            ],
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "green", "value": 1}
              ]
            },
            "unit": "none"
          }
        }
      },
      {
        "id": 2,
        "title": "📊 HTTP Requests Total",
        "type": "stat",
        "description": "Total number of HTTP requests served",
        "gridPos": {"h": 3, "w": 6, "x": 6, "y": 0},
        "targets": [{
          "expr": "sum(flask_http_request_total)",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "min": 0
          }
        }
      },
      {
        "id": 3,
        "title": "⚡ Request Rate (requests/sec)",
        "type": "graph",
        "description": "HTTP request rate over time",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 3},
        "targets": [{
          "expr": "rate(flask_http_request_total[1m])",
          "legendFormat": "{{method}} {{endpoint}}",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "min": 0
          }
        }
      },
      {
        "id": 4,
        "title": "🎯 Active Pods",
        "type": "stat",
        "description": "Number of running application pods",
        "gridPos": {"h": 3, "w": 6, "x": 12, "y": 0},
        "targets": [{
          "expr": "count(up{job='flask-devsecops'})",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "min": 0,
            "max": 10
          }
        }
      },
      {
        "id": 5,
        "title": "📝 Application Logs",
        "type": "logs",
        "description": "Recent application logs from Loki",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 3},
        "targets": [{
          "expr": "{app=\"flask-devsecops\"}",
          "refId": "A",
          "queryType": "range"
        }],
        "options": {
          "showTime": true,
          "wrapLogMessage": true,
          "showLabels": true,
          "showCommonLabels": false,
          "prettifyLogMessage": false,
          "enableLogDetails": true,
          "dedupStrategy": "none",
          "sortOrder": "Descending"
        }
      },
      {
        "id": 6,
        "title": "🔍 Error Logs",
        "type": "logs",
        "description": "Error and warning level logs only",
        "gridPos": {"h": 5, "w": 12, "x": 0, "y": 11},
        "targets": [{
          "expr": "{app=\"flask-devsecops\"} |= \"ERROR\" or {app=\"flask-devsecops\"} |= \"WARNING\"",
          "refId": "A",
          "queryType": "range"
        }],
        "options": {
          "showTime": true,
          "wrapLogMessage": true,
          "showLabels": false,
          "prettifyLogMessage": true
        }
      },
      {
        "id": 7,
        "title": "📈 HTTP Status Distribution",
        "type": "piechart",
        "description": "Distribution of HTTP status codes",
        "gridPos": {"h": 5, "w": 12, "x": 12, "y": 11},
        "targets": [{
          "expr": "sum(flask_http_request_total) by (http_status)",
          "refId": "A",
          "legendFormat": "{{http_status}}"
        }]
      }
    ],
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    }
  },
  "overwrite": true,
  "message": "Flask DevSecOps dashboard created"
}
