{
  "dashboard": {
    "title": "Flask DevSecOps - Production Dashboard",
    "tags": ["flask", "python", "devsecops", "production"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "🏥 Application Health",
        "type": "stat",
        "description": "Overall application health (1 = Healthy, 0 = Unhealthy)",
        "gridPos": {"h": 3, "w": 4, "x": 0, "y": 0},
        "targets": [{
          "expr": "flask_health_status",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "mappings": [
              {
                "type": "value",
                "options": {
                  "1": {"text": "✅ HEALTHY"},
                  "0": {"text": "❌ UNHEALTHY"}
                }
              }
            ],
            "thresholds": {
              "steps": [
                {"color": "#FF0000", "value": null},
                {"color": "#299C46", "value": 1}
              ]
            },
            "unit": "none"
          }
        }
      },
      {
        "id": 2,
        "title": "📈 HTTP Requests (Total)",
        "type": "stat",
        "description": "Total HTTP requests served since startup",
        "gridPos": {"h": 3, "w": 4, "x": 4, "y": 0},
        "targets": [{
          "expr": "sum(flask_http_request_total)",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "min": 0,
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 3,
        "title": "⚡ Request Rate",
        "type": "stat",
        "description": "Current requests per second",
        "gridPos": {"h": 3, "w": 4, "x": 8, "y": 0},
        "targets": [{
          "expr": "sum(rate(flask_http_request_total[1m]))",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "min": 0,
            "decimals": 2
          }
        }
      },
      {
        "id": 4,
        "title": "🎯 Active Pods",
        "type": "stat",
        "description": "Number of healthy application pods",
        "gridPos": {"h": 3, "w": 4, "x": 12, "y": 0},
        "targets": [{
          "expr": "count(up{job='flask-devsecops'})",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "min": 0,
            "max": 10,
            "color": {"mode": "continuous-BlPu"}
          }
        }
      },
      {
        "id": 5,
        "title": "🚀 HTTP Traffic (Last 15 min)",
        "type": "graph",
        "description": "HTTP request rate by endpoint",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 3},
        "targets": [{
          "expr": "rate(flask_http_request_total[1m])",
          "legendFormat": "{{method}} {{endpoint}}",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "min": 0,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "barAlignment": 0,
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "none",
              "spanNulls": false,
              "showPoints": "auto",
              "pointSize": 5
            }
          }
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "calcs": ["mean", "last"]
          }
        }
      },
      {
        "id": 6,
        "title": "📊 HTTP Status Codes",
        "type": "piechart",
        "description": "Distribution of HTTP response status codes",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 3},
        "targets": [{
          "expr": "sum(flask_http_request_total) by (http_status)",
          "refId": "A",
          "legendFormat": "{{http_status}}"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "none"
          }
        },
        "options": {
          "pieType": "pie",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          }
        }
      },
      {
        "id": 7,
        "title": "📝 Application Logs - Parsed",
        "type": "table",
        "description": "Structured view of application logs (parsed from Loki)",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 11},
        "targets": [{
          "expr": "{app=\"flask-devsecops\"} | logfmt",
          "refId": "A",
          "queryType": "range",
          "maxLines": 50
        }],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "displayMode": "auto"
            }
          }
        },
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "filename": true,
                "namespace": true
              },
              "indexByName": {
                "Time": 0,
                "level": 1,
                "msg": 2,
                "pod": 3
              },
              "renameByName": {
                "Time": "Timestamp",
                "level": "Level",
                "msg": "Message",
                "pod": "Pod"
              }
            }
          }
        ],
        "options": {
          "showHeader": true,
          "footer": {
            "show": false,
            "reducer": ["sum"],
            "countRows": false
          }
        }
      },
      {
        "id": 8,
        "title": "🔍 Access Logs (Raw)",
        "type": "logs",
        "description": "Raw HTTP access logs from nginx/apache format",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 19},
        "targets": [{
          "expr": "{app=\"flask-devsecops\"} |~ \"GET|POST|PUT|DELETE\"",
          "refId": "A",
          "queryType": "range",
          "maxLines": 100
        }],
        "options": {
          "showTime": true,
          "wrapLogMessage": true,
          "showLabels": false,
          "showCommonLabels": false,
          "prettifyLogMessage": false,
          "enableLogDetails": true,
          "dedupStrategy": "none",
          "sortOrder": "Descending"
        }
      },
      {
        "id": 9,
        "title": "⚠️  Errors & Warnings",
        "type": "logs",
        "description": "Only error and warning level logs",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 19},
        "targets": [{
          "expr": "{app=\"flask-devsecops\"} |~ \"ERROR|WARNING|CRITICAL\"",
          "refId": "A",
          "queryType": "range"
        }],
        "options": {
          "showTime": true,
          "wrapLogMessage": true,
          "showLabels": true,
          "prettifyLogMessage": true,
          "sortOrder": "Descending"
        }
      },
      {
        "id": 10,
        "title": "⏱️  Request Latency (95th percentile)",
        "type": "graph",
        "description": "95th percentile request latency by endpoint",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 27},
        "targets": [{
          "expr": "histogram_quantile(0.95, sum(rate(flask_http_request_duration_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "min": 0,
            "decimals": 3
          }
        }
      },
      {
        "id": 11,
        "title": "📊 Custom Metrics",
        "type": "stat",
        "description": "Your custom business metrics",
        "gridPos": {"h": 3, "w": 8, "x": 12, "y": 27},
        "targets": [
          {
            "expr": "flask_announcements_total",
            "refId": "A",
            "legendFormat": "Announcements"
          },
          {
            "expr": "flask_user_registrations_total",
            "refId": "B",
            "legendFormat": "User Registrations"
          },
          {
            "expr": "flask_comments_total",
            "refId": "C",
            "legendFormat": "Comments"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "min": 0,
            "color": {"mode": "palette-classic"}
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "horizontal",
          "textMode": "value_and_name"
        }
      }
    ],
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    }
  },
  "overwrite": true,
  "message": "Optimized Flask DevSecOps dashboard with log parsing"
}
